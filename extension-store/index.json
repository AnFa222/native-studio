      "binaries": {
        "windows": "https://github.com/AnFa222/native-studio/releases/latest/download/native_python_variable_explorer.dll",
        "linux": "https://github.com/AnFa222/native-studio/releases/latest/download/native_python_variable_explorer.so",
        "macos": "https://github.com/AnFa222/native-studio/releases/latest/download/native_python_variable_explorer.dylib"
      }
    }
  ]
