{
  "manifestVersion": 1,
  "id": "dev.nativestudio.python_variable_explorer",
  "name": "Python Debugger",
  "version": "2.0.0",
  "abiVersion": 1,
  "description": "Native Python debugging with breakpoints, stepping, call stack, variables, and program output.",
  "author": "Native Studio",
  "permissions": ["ui.commands", "ui.views", "process.execute", "settings", "filesystem.read", "editor.read"],
  "binary": {
    "windows": "native_python_debugger.dll",
    "linux": "native_python_debugger.so",
    "macos": "native_python_debugger.dylib"
  }
}
